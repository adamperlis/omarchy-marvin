#!/bin/bash
# Marvin config layer.
#
#   install/marvin            install (snapshots first, then applies)
#   install/marvin --revert   put the system back exactly as it was
#   install/marvin --status   what is installed, what the snapshot holds
#
# Installs what `omarchy theme install` cannot carry: the light sibling,
# Inter for the shell, rounding/gaps/shadow/motion for Hyprland, and the
# restyled widget plugins. Before the first install it snapshots every file
# it will touch plus the active theme, so --revert is a restore, not a
# cleanup: files come back byte for byte, absent files are removed, the
# previous theme is set again, and the built-in widgets are re-enabled.
set -euo pipefail

THEME_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
CFG="$HOME/.config"
THEMES="$CFG/omarchy/themes"
PLUGINS="$CFG/omarchy/plugins"
HYPR="$CFG/hypr"
FONTCONF="$CFG/fontconfig/conf.d"
USERFONTS="$HOME/.local/share/fonts/marvin"
SHELL_JSON="$CFG/omarchy/shell.json"
STATE_DIR="$HOME/.local/state/marvin"
SNAP="$STATE_DIR/snapshot"
MARKER="-- marvin:config-layer"
REQUIRE_LINE='require("hypr.marvin") '"$MARKER"

# Everything install writes or changes, relative to ~/.config. A path listed
# here is restored from the snapshot on revert, or removed if the snapshot
# recorded it as absent.
TOUCHED=(
  "hypr/hyprland.lua"
  "hypr/marvin.lua"
  "fontconfig/conf.d/60-marvin-shell.conf"
  "gtk-3.0/gtk.css"
  "gtk-4.0/gtk.css"
  "omarchy/shell.json"
  "omarchy/themes/marvin-light"
)

say()  { printf '\e[1m%s\e[0m\n' "$*"; }
note() { printf '  %s\n' "$*"; }
shell_running() { pgrep -x quickshell >/dev/null 2>&1; }

# Run a slow command with a spinner on a terminal (and plainly when the output
# is redirected, e.g. the auto-update timer). Keeps the long shell reload from
# looking frozen.
with_spinner() {
  local msg="$1"; shift
  if [[ -t 1 ]]; then
    "$@" & local p=$! s='|/-\' i=0
    while kill -0 "$p" 2>/dev/null; do
      printf '\r  %s %s' "${s:i%4:1}" "$msg"; i=$((i + 1)); sleep 0.15
    done
    wait "$p"; local rc=$?
    printf '\r\033[K'
    return $rc
  fi
  "$@"
}

# The MARVIN wordmark, revealed line by line then swept with a blue shimmer.
# Terminal only, so the auto-update timer's log stays plain.
marvin_banner() {
  [[ -t 1 ]] || return 0
  local r=$'\e[0m' l c
  local -a L=(
'███╗   ███╗ █████╗ ██████╗ ██╗   ██╗██╗███╗   ██╗'
'████╗ ████║██╔══██╗██╔══██╗██║   ██║██║████╗  ██║'
'██╔████╔██║███████║██████╔╝██║   ██║██║██╔██╗ ██║'
'██║╚██╔╝██║██╔══██║██╔══██╗╚██╗ ██╔╝██║██║╚██╗██║'
'██║ ╚═╝ ██║██║  ██║██║  ██║ ╚████╔╝ ██║██║ ╚████║'
'╚═╝     ╚═╝╚═╝  ╚═╝╚═╝  ╚═╝  ╚═══╝  ╚═╝╚═╝  ╚═══╝'
  )
  printf '\n'
  for l in "${L[@]}"; do printf '  \e[38;5;75m%s%s\n' "$l" "$r"; sleep 0.05; done
  for c in 111 45 39 75; do
    printf '\e[6A'
    for l in "${L[@]}"; do printf '\r  \e[38;5;%sm%s%s\n' "$c" "$l" "$r"; done
    sleep 0.09
  done
  printf '  \e[38;5;68m%s%s\n\n' "a theme for Omarchy" "$r"
}
plugin_ids() { local p; for p in "$THEME_DIR"/plugins/marvin.*/; do basename "$p"; done; }
current_theme() { cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || true; }

# 1 on the very first install, 0 on every re-run (including auto-update). Set by
# snapshot(). Guards the one-time choices — which widgets to enable, the GTK
# font and accent — so an update refreshes code and colours without undoing
# anything the user has since changed.
FIRST_INSTALL=1

# ------------------------------------------------------------------ snapshot
# Taken once, before anything is changed. A re-run keeps the original
# snapshot, because a snapshot taken after install would only capture Marvin.
snapshot() {
  if [[ -f "$SNAP/state" ]]; then
    FIRST_INSTALL=0
    note "snapshot from $(sed -n 's/^taken=//p' "$SNAP/state") kept — this is an update"
    return
  fi
  FIRST_INSTALL=1
  say "Snapshot"
  mkdir -p "$SNAP/config"
  local rel
  for rel in "${TOUCHED[@]}"; do
    if [[ -e "$CFG/$rel" ]]; then
      mkdir -p "$SNAP/config/$(dirname "$rel")"
      cp -a "$CFG/$rel" "$SNAP/config/$rel"
      note "saved   $rel"
    else
      note "absent  $rel"
    fi
  done
  local id
  for id in $(plugin_ids); do
    [[ -e "$PLUGINS/$id" ]] && { mkdir -p "$SNAP/plugins"; cp -a "$PLUGINS/$id" "$SNAP/plugins/$id"; note "saved   plugins/$id"; }
  done
  {
    echo "taken=$(date -Is)"
    echo "theme=$(current_theme)"
    if command -v gsettings >/dev/null; then
      echo "gtk_font=$(gsettings get org.gnome.desktop.interface font-name 2>/dev/null || true)"
      echo "gtk_accent=$(gsettings get org.gnome.desktop.interface accent-color 2>/dev/null || true)"
    fi
  } >"$SNAP/state"
  note "previous theme: $(current_theme)"
  note "→ $SNAP"
}

# ------------------------------------------------------------------- install
install_light() {
  say "marvin-light"
  rm -rf "$THEMES/marvin-light"
  # A plain directory (no .git) is a theme the user wrote, so Omarchy stages
  # it unfiltered. Nothing in light/ runs code.
  cp -r "$THEME_DIR/light" "$THEMES/marvin-light"
  note "→ $THEMES/marvin-light"
}

install_font() {
  say "Fonts"
  # Vendored, OFL. Installed per user so nothing needs a package manager or
  # sudo, and so revert can take them out again. Runs on every install, not
  # just the first — the font has to be present for Obsidian's serif to work.
  mkdir -p "$USERFONTS"
  cp "$THEME_DIR"/fonts/*.ttf "$USERFONTS/"
  # Register with fontconfig so every app can resolve them. Rebuild the user
  # cache; if the serif still isn't listed, force a full rebuild.
  if command -v fc-cache >/dev/null; then
    fc-cache -f "$USERFONTS" >/dev/null 2>&1 || true
    if command -v fc-list >/dev/null && ! fc-list 2>/dev/null | grep -qi "libre baskerville"; then
      fc-cache -f >/dev/null 2>&1 || true
    fi
  fi
  # Verify, so a bad install is loud rather than a silent fall back to sans.
  if command -v fc-list >/dev/null; then
    if fc-list 2>/dev/null | grep -qi "libre baskerville"; then
      note "→ $USERFONTS — verified: Inter + Libre Baskerville registered"
    else
      note "! Libre Baskerville did not register — run:  fc-cache -f"
    fi
  else
    note "→ $USERFONTS (Inter, Libre Baskerville) — no fc-list to verify"
  fi
  # Electron apps (Obsidian) read the font list once at launch, so a running
  # instance won't see a just-installed font until it is restarted.
  note "restart Obsidian to pick up a newly installed font"
  mkdir -p "$FONTCONF"
  cp "$THEME_DIR/config/fontconfig/60-marvin-shell.conf" "$FONTCONF/60-marvin-shell.conf"
  note "→ $FONTCONF/60-marvin-shell.conf (Inter for quickshell only; terminals unchanged)"
}

install_gtk() {
  say "GTK apps"
  # Marvin's named-colour overrides for GTK 3 and 4, so file choosers, save
  # dialogs and GTK apps take the palette. This is theme content, not a user
  # preference, so it's (re)written on every run — matching the current tone.
  local css="$THEME_DIR/gtk.css" d
  [[ "$(current_theme)" == *light ]] && css="$THEME_DIR/light/gtk.css"
  for d in "$CFG/gtk-3.0" "$CFG/gtk-4.0"; do
    mkdir -p "$d"; cp "$css" "$d/gtk.css"
  done
  note "→ ~/.config/gtk-3.0/gtk.css, gtk-4.0/gtk.css (save dialogs and GTK apps)"

  command -v gsettings >/dev/null || { note "no gsettings; font and accent skipped"; return; }
  # First install only: the font and accent are user-visible preferences, so an
  # update must not stomp ones the user has since chosen for themselves.
  if [[ "$FIRST_INSTALL" != 1 ]]; then
    note "left your GTK font and accent as they are"
    return
  fi
  # Omarchy never sets a GTK font, so Files and every GTK app run on the
  # sans-serif fallback. Inter at 10pt is 13px at 96 dpi: the body size.
  gsettings set org.gnome.desktop.interface font-name "Inter 10" 2>/dev/null && note "font-name → Inter 10" || true
  # libadwaita derives per-scheme accent colours from the named accent, so
  # one setting serves both tones.
  gsettings set org.gnome.desktop.interface accent-color "blue" 2>/dev/null && note "accent-color → blue" || true
}

install_hypr() {
  say "Hyprland geometry and motion"
  mkdir -p "$HYPR"
  cp "$THEME_DIR/config/hypr/marvin.lua" "$HYPR/marvin.lua"
  if [[ -f "$HYPR/hyprland.lua" ]] && ! grep -qF -- "$MARKER" "$HYPR/hyprland.lua"; then
    # After the user's looknfeel so Marvin's values are what Hyprland ends on;
    # before toggles so the user's toggles can still flip them.
    if grep -qF 'require("hypr.looknfeel")' "$HYPR/hyprland.lua"; then
      sed -i "/require(\"hypr.looknfeel\")/a $REQUIRE_LINE" "$HYPR/hyprland.lua"
    else
      printf '\n%s\n' "$REQUIRE_LINE" >>"$HYPR/hyprland.lua"
    fi
  fi
  note "→ $HYPR/marvin.lua, required from hyprland.lua"
}

install_plugins() {
  say "Widgets"
  mkdir -p "$PLUGINS"
  local p id
  for p in "$THEME_DIR"/plugins/marvin.*/; do
    id=$(basename "$p")
    rm -rf "$PLUGINS/$id"
    cp -r "$p" "$PLUGINS/$id"
    note "→ $PLUGINS/$id"
  done
  if shell_running; then
    # Rescan always, so the shell picks up updated QML for widgets already on
    # the bar. But only auto-enable on the first install — on an update the
    # user's choice of which widgets are on, and where, is theirs to keep.
    omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
    if [[ "$FIRST_INSTALL" == 1 ]]; then
      for id in $(plugin_ids); do
        # Clones replace a built-in and inherit its slot, so they need no
        # placement. The three that clone nothing — weather, mode, todos — would
        # land enabled-but-unplaced (invisible), so give them a bar section.
        local sect=""
        case "$id" in
          marvin.weather)           sect="center" ;;
          marvin.mode|marvin.todos) sect="right" ;;
        esac
        if [[ -n "$sect" ]] && command -v omarchy >/dev/null 2>&1; then
          omarchy plugin enable "$id" --section "$sect" >/dev/null 2>&1 \
            && note "enabled $id ($sect)" \
            || note "enable $id yourself: omarchy plugin enable $id --section $sect"
        else
          omarchy-plugin-enable "$id" >/dev/null 2>&1 && note "enabled $id" || note "enable $id yourself: omarchy plugin enable $id"
        fi
      done
    else
      note "kept your widget layout (refreshed their code only)"
    fi
  else
    note "shell not running; enable later with: omarchy plugin enable marvin.<name>"
  fi
}

# Write via a temp file and rename, never straight over the target. marvin-update
# runs this installer from inside itself, and bash reads a running script lazily
# from an open fd, by byte offset. `cp` truncates that same inode, so bash
# resumed at the old offset inside the new, longer text, landed mid-token and
# reported a phantom "syntax error on line 128" *after* a fully successful
# update. A rename swaps the directory entry and leaves the running script's
# inode intact, so bash reads the file it started with, through to its real end.
install_bin() {
  local src="$1" dst="$2" tmp
  tmp=$(mktemp "$(dirname "$dst")/.$(basename "$dst").XXXXXX")
  cat "$src" >"$tmp" && chmod 755 "$tmp" && mv -f "$tmp" "$dst" || { rm -f "$tmp"; return 1; }
}

install_mode() {
  say "Light/dark control and updates"
  # marvin-mode and marvin-update are executables, so they cannot ship in the
  # theme (a git-installed theme drops anything that can run code). They live in
  # the config layer instead.
  mkdir -p "$HOME/.local/bin"
  install_bin "$THEME_DIR/bin/marvin-mode" "$HOME/.local/bin/marvin-mode"
  install_bin "$THEME_DIR/bin/marvin-update" "$HOME/.local/bin/marvin-update"
  install_bin "$THEME_DIR/bin/marvin-todo" "$HOME/.local/bin/marvin-todo"
  note "→ ~/.local/bin/marvin-mode    (toggle · system · schedule)"
  note "→ ~/.local/bin/marvin-update  (pull + re-apply; --enable for a daily timer)"
  note "→ ~/.local/bin/marvin-todo    (backs the marvin.todos widget; ~/todos.md)"
  # Auto-update on by default — but only turn it on at first install. On an
  # update, whatever the user set (they may have turned it off in the panel) is
  # left alone; re-enabling here would override their choice.
  if [[ "$FIRST_INSTALL" == 1 ]]; then
    "$HOME/.local/bin/marvin-update" --enable >/dev/null 2>&1 || true
    note "auto-update: on (daily) — turn off in the marvin.mode panel or with marvin-update --disable"
  else
    note "auto-update left as you set it"
  fi
}

# ---------------------------------------------------------------- obsidian
# Every registered Obsidian vault. Native, Flatpak and Snap keep the same
# vault registry, just at different paths.
obsidian_vaults() {
  local reg
  for reg in "$CFG/obsidian/obsidian.json" \
             "$HOME/.var/app/md.obsidian.Obsidian/config/obsidian/obsidian.json" \
             "$HOME/snap/obsidian/current/.config/obsidian/obsidian.json"; do
    [[ -f "$reg" ]] && jq -r '.vaults[]?.path // empty' "$reg" 2>/dev/null
  done | sort -u
}

# Omarchy copies obsidian.css only into vaults it already knows, so a vault it
# hasn't seen gets nothing. Install the theme into every registered vault and
# switch to it — but only when the vault is still on the default theme, so a
# theme the user chose themselves is never overridden.
install_obsidian() {
  say "Obsidian"
  command -v jq >/dev/null || { note "no jq; skipped (Obsidian styling needs it)"; return; }
  local css="$THEME_DIR/obsidian.css"
  [[ "$(current_theme)" == *light ]] && css="$THEME_DIR/light/obsidian.css"
  local found=0 vault dir appearance cur tmp
  while IFS= read -r vault; do
    [[ -z "$vault" || ! -d "$vault/.obsidian" ]] && continue
    found=1
    dir="$vault/.obsidian/themes/Marvin"
    mkdir -p "$dir"
    cp "$css" "$dir/theme.css"
    cat >"$dir/manifest.json" <<'JSON'
{ "name": "Marvin", "version": "1.0.0", "minAppVersion": "1.0.0", "author": "Marvin theme", "authorUrl": "https://github.com/adamperlis/omarchy-marvin" }
JSON
    note "→ ${vault##*/}/.obsidian/themes/Marvin"
    appearance="$vault/.obsidian/appearance.json"
    cur=""
    [[ -f "$appearance" ]] && cur=$(jq -r '.cssTheme // ""' "$appearance" 2>/dev/null || echo "")
    if [[ -z "$cur" ]]; then
      if [[ -f "$appearance" ]]; then
        tmp=$(mktemp); jq '.cssTheme = "Marvin"' "$appearance" >"$tmp" && mv "$tmp" "$appearance"
      else
        printf '{\n  "cssTheme": "Marvin"\n}\n' >"$appearance"
      fi
      note "activated Marvin in ${vault##*/}"
    elif [[ "$cur" == "Marvin" ]]; then
      note "Marvin already active in ${vault##*/} (css refreshed)"
    else
      note "left ${vault##*/} on your theme ($cur) — pick Marvin in Appearance to switch"
    fi
  done < <(obsidian_vaults)
  if [[ $found -eq 0 ]]; then
    note "no Obsidian vaults found — open one once, then re-run install/marvin"
  else
    note "restart Obsidian to see it (it loads themes and fonts at launch)"
  fi
}

# Revert: drop the Marvin theme from each vault, and if it was the active one,
# fall back to the default theme.
uninstall_obsidian() {
  command -v jq >/dev/null || return 0
  local vault appearance cur tmp
  while IFS= read -r vault; do
    [[ -z "$vault" ]] && continue
    rm -rf "$vault/.obsidian/themes/Marvin"
    appearance="$vault/.obsidian/appearance.json"
    [[ -f "$appearance" ]] || continue
    cur=$(jq -r '.cssTheme // ""' "$appearance" 2>/dev/null || echo "")
    if [[ "$cur" == "Marvin" ]]; then
      tmp=$(mktemp); jq '.cssTheme = ""' "$appearance" >"$tmp" && mv "$tmp" "$appearance"
      note "reverted Obsidian theme in ${vault##*/}"
    fi
  done < <(obsidian_vaults)
}

apply() {
  say "Applying"
  # Set the theme only on a first install (coming from another theme). Omarchy's
  # theme-set advances the wallpaper one file per run when the current one is
  # already in the theme's set, so re-setting on a reinstall would change a
  # background the user chose. When already on Marvin, leave the theme — and the
  # wallpaper — alone; the geometry and shell still reload below. A first install
  # lands on the blue default (0-marvin.jpg, sorted first).
  local cur; cur=$(current_theme)
  if [[ "$cur" != marvin && "$cur" != marvin-light ]]; then
    command -v omarchy-theme-set >/dev/null && omarchy-theme-set marvin >/dev/null 2>&1 && note "theme set to marvin (wallpaper: the blue default)" || true
  else
    note "already on $cur; theme and wallpaper left as they are"
  fi
  # Never leave a black desktop: if the wallpaper doesn't resolve to a real file,
  # set the blue default (0-*).
  local bg_link="$HOME/.local/state/omarchy/current/background" d def
  if command -v omarchy-theme-bg-set >/dev/null 2>&1 \
     && { [[ ! -e "$bg_link" ]] || [[ ! -f "$(readlink -f "$bg_link" 2>/dev/null)" ]]; }; then
    for d in "$CFG/omarchy/backgrounds/marvin" "$THEME_DIR/backgrounds"; do
      def=$(ls "$d"/0-*.jpg 2>/dev/null | head -1)
      [[ -n "$def" ]] && { omarchy-theme-bg-set "$def" >/dev/null 2>&1 && note "wallpaper set (blue default)"; break; }
    done
  fi
  # Restore the appearance the user chose (light / dark / auto). A reinstall runs
  # `omarchy theme set marvin` first, which forces dark; this puts their choice
  # back. Recorded by marvin-mode, so it survives every reinstall and update.
  if [[ "$FIRST_INSTALL" != 1 && -x "$HOME/.local/bin/marvin-mode" ]]; then
    "$HOME/.local/bin/marvin-mode" reassert >/dev/null 2>&1 && note "restored your appearance choice" || true
  fi
  command -v hyprctl >/dev/null && hyprctl reload >/dev/null 2>&1 || true
  if shell_running; then
    say "Restarting the shell"
    note "the bar disappears and comes back — this takes a few seconds"
    with_spinner "reloading the shell…" bash -c 'omarchy-restart-shell >/dev/null 2>&1 || true'
    note "if the bar isn't back yet, give it a moment (a 'shell not ready' notice is harmless)"
  fi
  note "done. Light: omarchy theme set marvin-light. Undo everything: install/marvin --revert"
}

# -------------------------------------------------------------------- revert
# Restore from the snapshot. Order matters: disable the clones while the
# shell can still see them (so it re-enables the built-ins itself), then put
# files back, then clean shell.json as a fallback for the case where the
# shell was not running, then set the previous theme.
revert() {
  say "Reverting to the snapshot"
  if [[ ! -f "$SNAP/state" ]]; then
    note "no snapshot at $SNAP — falling back to removal of everything Marvin added"
  fi

  local id
  if shell_running; then
    for id in $(plugin_ids); do omarchy-plugin-disable "$id" >/dev/null 2>&1 || true; done
  fi

  local rel
  for rel in "${TOUCHED[@]}"; do
    if [[ -e "$SNAP/config/$rel" ]]; then
      rm -rf "$CFG/$rel"
      mkdir -p "$(dirname "$CFG/$rel")"
      cp -a "$SNAP/config/$rel" "$CFG/$rel"
      note "restored $rel"
    elif [[ -f "$SNAP/state" ]]; then
      rm -rf "$CFG/$rel"
      note "removed  $rel (was absent)"
    else
      # No snapshot: undo only what is recognisably ours.
      case "$rel" in
        hypr/hyprland.lua) [[ -f "$CFG/$rel" ]] && sed -i "/$MARKER/d" "$CFG/$rel" && note "cleaned  $rel" ;;
        omarchy/shell.json) ;;  # handled below
        *) rm -rf "$CFG/$rel"; note "removed  $rel" ;;
      esac
    fi
  done

  for id in $(plugin_ids); do
    rm -rf "$PLUGINS/$id"
    [[ -e "$SNAP/plugins/$id" ]] && cp -a "$SNAP/plugins/$id" "$PLUGINS/$id" && note "restored plugins/$id"
  done

  rm -rf "$USERFONTS"; command -v fc-cache >/dev/null && fc-cache -f >/dev/null 2>&1 || true
  note "removed  ~/.local/share/fonts/marvin"

  if [[ -x "$HOME/.local/bin/marvin-mode" ]]; then
    "$HOME/.local/bin/marvin-mode" unschedule >/dev/null 2>&1 || true
    "$HOME/.local/bin/marvin-mode" follow-off >/dev/null 2>&1 || true
  fi
  [[ -x "$HOME/.local/bin/marvin-update" ]] && "$HOME/.local/bin/marvin-update" --disable >/dev/null 2>&1 || true
  rm -f "$HOME/.local/bin/marvin-mode" "$HOME/.local/bin/marvin-update" "$HOME/.local/bin/marvin-todo"
  note "removed  ~/.local/bin/marvin-mode, marvin-update, marvin-todo, and any timers"

  uninstall_obsidian

  clean_shell_json

  if command -v gsettings >/dev/null && [[ -f "$SNAP/state" ]]; then
    local gf ga
    gf=$(sed -n 's/^gtk_font=//p' "$SNAP/state"); ga=$(sed -n 's/^gtk_accent=//p' "$SNAP/state")
    if [[ -n $gf ]]; then gsettings set org.gnome.desktop.interface font-name "${gf//\'/}" 2>/dev/null || true; else gsettings reset org.gnome.desktop.interface font-name 2>/dev/null || true; fi
    if [[ -n $ga ]]; then gsettings set org.gnome.desktop.interface accent-color "${ga//\'/}" 2>/dev/null || true; else gsettings reset org.gnome.desktop.interface accent-color 2>/dev/null || true; fi
    note "GTK font and accent restored"
  fi

  local previous
  previous=$(sed -n 's/^theme=//p' "$SNAP/state" 2>/dev/null || true)
  if [[ -n $previous && $previous != marvin && $previous != marvin-light ]] && command -v omarchy-theme-set >/dev/null; then
    omarchy-theme-set "$previous" >/dev/null 2>&1 && note "theme set back to $previous" || note "could not set theme $previous; omarchy theme set <name> yourself"
  fi

  command -v hyprctl >/dev/null && hyprctl reload >/dev/null 2>&1 || true
  shell_running && omarchy-restart-shell >/dev/null 2>&1 || true

  rm -rf "$SNAP"
  note "snapshot consumed. The theme itself is still installed: omarchy theme remove marvin"
}

# shell.json fallback: drop every marvin.* entry and re-enable each built-in
# a clone had disabled. A no-op when the file was restored from the snapshot
# or never existed.
clean_shell_json() {
  [[ -f "$SHELL_JSON" ]] || return 0
  grep -q '"marvin\.' "$SHELL_JSON" || return 0
  command -v jq >/dev/null || { note "shell.json still references marvin.* and jq is missing; edit it by hand"; return 0; }
  local sources
  sources=$(for p in "$THEME_DIR"/plugins/marvin.*/manifest.json; do jq -r '.omarchy.clonedFrom // empty' "$p"; done | jq -R . | jq -s .)
  local tmp; tmp=$(mktemp)
  jq --argjson sources "$sources" '
    def notMarvin: select((.id // .) | tostring | startswith("marvin.") | not);
    (.bar.layout // {}) |= with_entries(.value |= map(notMarvin))
    | (.plugins // []) |= map(notMarvin)
    | (.disabledPlugins // []) |= map(select(. as $d | $sources | index($d) | not))
    | if (.bar.id // "") | startswith("marvin.") then .bar.id = "omarchy.bar" else . end
  ' "$SHELL_JSON" >"$tmp" && mv "$tmp" "$SHELL_JSON"
  note "cleaned  omarchy/shell.json (marvin.* entries out, built-ins re-enabled)"
}

status() {
  say "Marvin config layer"
  local rel
  for rel in "${TOUCHED[@]}"; do
    [[ -e "$CFG/$rel" ]] && note "present  $rel" || note "absent   $rel"
  done
  local id; for id in $(plugin_ids); do [[ -e "$PLUGINS/$id" ]] && note "present  plugins/$id"; done
  [[ -x "$HOME/.local/bin/marvin-mode" ]] && note "present  ~/.local/bin/marvin-mode" && "$HOME/.local/bin/marvin-mode" status 2>/dev/null | sed 's/^/    /'
  [[ -x "$HOME/.local/bin/marvin-update" ]] && note "present  ~/.local/bin/marvin-update" && "$HOME/.local/bin/marvin-update" --status 2>/dev/null | sed 's/^/    /'
  if [[ -f "$HYPR/hyprland.lua" ]] && grep -qF -- "$MARKER" "$HYPR/hyprland.lua"; then note "hyprland.lua requires hypr.marvin"; fi
  note "active theme: $(current_theme)"
  if [[ -f "$SNAP/state" ]]; then
    say "Snapshot"; sed 's/^/  /' "$SNAP/state"
    find "$SNAP" -mindepth 2 \( -type f -o -type d -name "marvin*" \) -not -path "*/marvin*/*" | sed "s|$SNAP/|  |" | sort
  else
    note "no snapshot (nothing installed yet, or already reverted)"
  fi
}

case "${1:-}" in
  --revert|--remove) revert ;;
  --status) status ;;
  -h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//' ;;
  "") marvin_banner; snapshot; install_light; install_font; install_gtk; install_hypr; install_plugins; install_mode; install_obsidian; apply ;;
  *) echo "usage: install/marvin [--revert | --status]" >&2; exit 1 ;;
esac
