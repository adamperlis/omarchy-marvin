#!/bin/bash
# marvin-update — pull the latest Marvin and re-apply it, keeping your wallpaper.
#
# Marvin is a git checkout under ~/.config/omarchy/themes/marvin, so an update
# is a fast-forward pull plus a re-apply. Omarchy has no auto-update for
# third-party themes; this is the config layer's own, opt-in.
#
#   marvin-update                 pull and re-apply now
#   marvin-update --enable [when] run it on a timer (systemd OnCalendar; default daily)
#   marvin-update --disable       stop the timer
#   marvin-update --status        is the timer on?
set -euo pipefail

THEMES="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/themes"
THEME_DIR="$THEMES/marvin"
UNITS="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
BG_LINK="$HOME/.local/state/omarchy/current/background"

current_theme() { cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || true; }

run() {
  [ -d "$THEME_DIR/.git" ] || { echo "marvin-update: $THEME_DIR is not a git checkout"; exit 1; }
  local before after
  before=$(git -C "$THEME_DIR" rev-parse HEAD 2>/dev/null || true)
  git -C "$THEME_DIR" pull --ff-only >/dev/null 2>&1 || { echo "marvin-update: pull failed (local changes?)"; exit 1; }
  after=$(git -C "$THEME_DIR" rev-parse HEAD 2>/dev/null || true)
  if [ "$before" = "$after" ]; then echo "marvin-update: already up to date"; return 0; fi
  echo "marvin-update: ${before:0:7} → ${after:0:7}"

  # Config layer (plugins, marvin.lua, fonts, marvin-mode, marvin-update). Its
  # apply() leaves the theme and wallpaper alone when already on Marvin.
  bash "$THEME_DIR/install/marvin" >/dev/null 2>&1 || true

  # Re-stage the theme so new colours, app theme files and backgrounds take
  # effect — then put the wallpaper back, since theme-set advances it one file
  # per run. Restore by NAME from the theme's own backgrounds dir, not by the
  # old symlink path: theme-set atomically replaces current/theme, so a path
  # captured before re-staging can dangle and the wallpaper resets. Same logic
  # marvin-mode uses across a tone switch.
  local cur; cur=$(current_theme)
  if [[ "$cur" == marvin || "$cur" == marvin-light ]] && command -v omarchy-theme-set >/dev/null; then
    local before_bg base=""
    before_bg=$(readlink -f "$BG_LINK" 2>/dev/null || true)
    [ -n "$before_bg" ] && [ -f "$before_bg" ] && base=$(basename "$before_bg")

    omarchy-theme-set "$cur" >/dev/null 2>&1 || true

    if [ -n "$base" ] && command -v omarchy-theme-bg-set >/dev/null 2>&1; then
      local now d
      now=$(basename "$(readlink -f "$BG_LINK" 2>/dev/null || true)" 2>/dev/null || true)
      # Only re-select if theme-set didn't already land on the same wallpaper,
      # and only from the stable dirs (user overlay first, then the theme's own).
      if [ "$now" != "$base" ]; then
        for d in "$HOME/.config/omarchy/backgrounds/$cur" "$HOME/.config/omarchy/themes/$cur/backgrounds"; do
          [ -f "$d/$base" ] && { omarchy-theme-bg-set "$d/$base" >/dev/null 2>&1; break; }
        done
      fi
    fi
  fi

  # Restore the appearance the user chose (auto / light / dark). This runs from
  # the systemd user session, so it can reach `systemctl --user` to re-arm the
  # daily schedule even if the panel's detached call couldn't when Auto was set.
  [ -x "$HOME/.local/bin/marvin-mode" ] && "$HOME/.local/bin/marvin-mode" reassert >/dev/null 2>&1 || true

  command -v omarchy-notification-send >/dev/null 2>&1 \
    && omarchy-notification-send "Marvin updated" "$(git -C "$THEME_DIR" log --oneline -1)" >/dev/null 2>&1 || true
  echo "marvin-update: done"
}

# Is the checkout behind upstream? Fetch-only — never touches the working tree,
# so it is safe to run from the bar on a timer. Prints "behind N" then the
# incoming log, or "up to date", or "unknown" (no checkout / offline).
check() {
  [ -d "$THEME_DIR/.git" ] || { echo "unknown"; return 0; }
  GIT_TERMINAL_PROMPT=0 timeout 15 git -C "$THEME_DIR" fetch --quiet 2>/dev/null \
    || { echo "unknown"; return 0; }
  local upstream count
  upstream=$(git -C "$THEME_DIR" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
  [ -n "$upstream" ] || { echo "up to date"; return 0; }
  count=$(git -C "$THEME_DIR" rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)
  if [ "${count:-0}" -gt 0 ]; then
    echo "behind $count"
    git -C "$THEME_DIR" log --oneline "HEAD..$upstream" 2>/dev/null | head -5 || true
  else
    echo "up to date"
  fi
}

case "${1:-run}" in
  run|"") run ;;
  --check|check) check ;;
  --enable|enable)
    when="${2:-daily}"
    mkdir -p "$UNITS"
    cat >"$UNITS/marvin-update.service" <<EOF
[Unit]
Description=Update the Marvin theme
[Service]
Type=oneshot
ExecStart=%h/.local/bin/marvin-update run
EOF
    cat >"$UNITS/marvin-update.timer" <<EOF
[Unit]
Description=Update Marvin on a schedule
[Timer]
OnCalendar=$when
Persistent=true
[Install]
WantedBy=timers.target
EOF
    systemctl --user daemon-reload
    systemctl --user enable --now marvin-update.timer >/dev/null 2>&1
    echo "marvin-update: auto-update on ($when)" ;;
  --disable|disable)
    systemctl --user disable --now marvin-update.timer >/dev/null 2>&1 || true
    rm -f "$UNITS/marvin-update.timer" "$UNITS/marvin-update.service"
    systemctl --user daemon-reload
    echo "marvin-update: auto-update off" ;;
  --status|status)
    systemctl --user is-enabled marvin-update.timer >/dev/null 2>&1 && echo "auto-update: on" || echo "auto-update: off" ;;
  *)
    echo "usage: marvin-update [run] | --check | --enable [daily|weekly|HH:MM] | --disable | --status" >&2
    exit 1 ;;
esac
