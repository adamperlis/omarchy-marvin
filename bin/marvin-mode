#!/bin/bash
# marvin-mode — Marvin's light/dark control: a manual toggle, a daily schedule,
# or in step with the system colour-scheme.
#
# It switches between two Omarchy themes: `marvin` (dark) and `marvin-light`.
# Part of the config layer, not the theme — a git-installed theme cannot ship
# executables. Installed to ~/.local/bin by install/marvin.
#
#   marvin-mode dark | light        set a mode
#   marvin-mode toggle              switch to the other
#   marvin-mode system              match the system colour-scheme once
#   marvin-mode follow              keep matching the system colour-scheme (foreground)
#   marvin-mode follow-on|follow-off  run `follow` as a background service
#   marvin-mode schedule [HH:MM HH:MM]  light at the first time, dark at the second
#                                       (defaults 07:00 and 19:00), every day
#   marvin-mode unschedule          remove the schedule
#   marvin-mode status              current mode, schedule and follow state
set -euo pipefail

DARK=marvin
LIGHT=marvin-light
UNITS="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
BG_LINK="$HOME/.local/state/omarchy/current/background"
# The appearance the user chose — "auto [L D]", "light" or "dark" — recorded so
# it survives updates and shell restarts (the systemd timers alone did not).
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/marvin"
APPEARANCE="$STATE/appearance"

# Switch tone, keeping the wallpaper: theme-set advances the background one file
# per run, so remember the current one and re-select the same-named wallpaper in
# the new tone (0-marvin ↔ 0-marvin, 5-citrus ↔ 5-citrus). If there is no match,
# leave Omarchy's choice.
set_theme() {
  local target="$1" base=""
  [ -L "$BG_LINK" ] && base=$(basename "$(readlink "$BG_LINK")")
  if command -v omarchy-theme-set >/dev/null 2>&1; then
    omarchy-theme-set "$target" >/dev/null 2>&1
  else
    omarchy theme set "$target"
  fi
  if [ -n "$base" ] && command -v omarchy-theme-bg-set >/dev/null 2>&1; then
    # theme-set already set a wallpaper; only swap again if it didn't land on
    # the one we're preserving. Skipping the redundant swap avoids a visible
    # flash to the default and back on every tone change.
    local now="" d
    [ -L "$BG_LINK" ] && now=$(basename "$(readlink "$BG_LINK")")
    if [ "$now" != "$base" ]; then
      for d in "$HOME/.config/omarchy/backgrounds/$target" "$HOME/.config/omarchy/themes/$target/backgrounds"; do
        [ -f "$d/$base" ] && { omarchy-theme-bg-set "$d/$base" >/dev/null 2>&1; break; }
      done
    fi
  fi
  # Apps that follow the system dark/light scheme — OmaWrite (Qt), GNOME apps —
  # can't read a theme file, so point the freedesktop colour-scheme at Marvin's
  # tone and they track it.
  if command -v gsettings >/dev/null 2>&1; then
    case "$target" in
      *light) gsettings set org.gnome.desktop.interface color-scheme 'prefer-light' 2>/dev/null || true ;;
      *)      gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'  2>/dev/null || true ;;
    esac
  fi
  # GTK apps take Marvin's palette per tone — re-copy the matching gtk.css so a
  # tone switch recolours file choosers and GTK apps too (picked up on their
  # next launch).
  local gsrc gd
  case "$target" in
    *light) gsrc="$HOME/.config/omarchy/themes/marvin/light/gtk.css" ;;
    *)      gsrc="$HOME/.config/omarchy/themes/marvin/gtk.css" ;;
  esac
  if [ -f "$gsrc" ]; then
    for gd in "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"; do
      mkdir -p "$gd"; cp "$gsrc" "$gd/gtk.css" 2>/dev/null || true
    done
  fi
}

current() { cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || true; }

# Record the appearance intent. The schedule's own flips use `apply-scheduled`,
# which does NOT record, so a scheduled light/dark change never overwrites "auto".
record() { mkdir -p "$STATE"; printf '%s\n' "$*" >"$APPEARANCE"; }

# dark unless the system explicitly asks for light
sys_is_dark() {
  local s
  s=$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null || true)
  case "$s" in
    *prefer-light*|*'light'*|*default*) return 1 ;;
    *) return 0 ;;
  esac
}

svc() { # write a oneshot service that flips to a mode
  mkdir -p "$UNITS"
  cat >"$UNITS/marvin-$1.service" <<EOF
[Unit]
Description=Marvin $1 mode
[Service]
Type=oneshot
ExecStart=%h/.local/bin/marvin-mode apply-scheduled $1
EOF
}

timer() { # $1 mode, $2 HH:MM
  cat >"$UNITS/marvin-$1.timer" <<EOF
[Unit]
Description=Marvin $1 at $2
[Timer]
OnCalendar=*-*-* $2:00
Persistent=true
[Install]
WantedBy=timers.target
EOF
}

case "${1:-status}" in
  dark)   set_theme "$DARK";  record dark ;;
  light)  set_theme "$LIGHT"; record light ;;
  toggle) if [ "$(current)" = "$LIGHT" ]; then set_theme "$DARK"; record dark; else set_theme "$LIGHT"; record light; fi ;;
  system) if sys_is_dark; then set_theme "$DARK"; record dark; else set_theme "$LIGHT"; record light; fi ;;
  # Internal: the schedule's timers flip tone through this, which does not record,
  # so a scheduled change never clobbers the recorded "auto" intent.
  apply-scheduled)
    case "${2:-dark}" in light) set_theme "$LIGHT" ;; *) set_theme "$DARK" ;; esac ;;
  follow)
    "$0" system
    # re-run on every colour-scheme change; blocks, so run under follow-on
    gsettings monitor org.gnome.desktop.interface color-scheme 2>/dev/null | while read -r _; do
      "$0" system
    done ;;
  follow-on)
    mkdir -p "$UNITS"
    cat >"$UNITS/marvin-follow.service" <<EOF
[Unit]
Description=Marvin follows the system colour-scheme
[Service]
ExecStart=%h/.local/bin/marvin-mode follow
Restart=on-failure
[Install]
WantedBy=default.target
EOF
    systemctl --user daemon-reload
    systemctl --user enable --now marvin-follow.service
    echo "Marvin: following the system colour-scheme" ;;
  follow-off)
    systemctl --user disable --now marvin-follow.service 2>/dev/null || true
    rm -f "$UNITS/marvin-follow.service"
    systemctl --user daemon-reload
    echo "Marvin: no longer following the system" ;;
  schedule)
    L="${2:-07:00}"; D="${3:-19:00}"
    svc light; svc dark; timer light "$L"; timer dark "$D"
    systemctl --user daemon-reload
    systemctl --user enable --now marvin-light.timer marvin-dark.timer >/dev/null 2>&1
    record "auto $L $D"
    echo "Marvin: light at $L, dark at $D, every day"
    # set the correct mode for right now (without recording — this is a flip)
    now=$(date +%H:%M)
    if [[ "$now" > "$L" && "$now" < "$D" ]]; then "$0" apply-scheduled light; else "$0" apply-scheduled dark; fi ;;
  unschedule)
    systemctl --user disable --now marvin-light.timer marvin-dark.timer >/dev/null 2>&1 || true
    rm -f "$UNITS"/marvin-light.timer "$UNITS"/marvin-dark.timer "$UNITS"/marvin-light.service "$UNITS"/marvin-dark.service
    systemctl --user daemon-reload
    # No longer auto — the current tone becomes the recorded intent.
    [ "$(current)" = "$LIGHT" ] && record light || record dark
    echo "Marvin: schedule removed" ;;
  reassert)
    # Restore the recorded appearance after an update or restart, from a context
    # (systemd timer, login shell) that can actually reach `systemctl --user`.
    want=""; a=""; b=""
    [ -f "$APPEARANCE" ] && read -r want a b <"$APPEARANCE" || true
    case "$want" in
      auto)  systemctl --user is-enabled marvin-light.timer >/dev/null 2>&1 \
               || "$0" schedule "${a:-07:00}" "${b:-19:00}" ;;
      light) [ "$(current)" != "$LIGHT" ] && set_theme "$LIGHT" || true ;;
      dark)  [ "$(current)" != "$DARK" ]  && set_theme "$DARK"  || true ;;
    esac ;;
  status)
    echo "mode:     $(current)"
    if systemctl --user is-enabled marvin-light.timer >/dev/null 2>&1; then
      echo "schedule: $(systemctl --user cat marvin-light.timer 2>/dev/null | sed -n 's/^OnCalendar=.* //p') light / $(systemctl --user cat marvin-dark.timer 2>/dev/null | sed -n 's/^OnCalendar=.* //p') dark"
    else
      echo "schedule: off"
    fi
    systemctl --user is-active marvin-follow.service >/dev/null 2>&1 && echo "follow:   on" || echo "follow:   off" ;;
  *)
    echo "usage: marvin-mode dark|light|toggle|system|follow|follow-on|follow-off|schedule [HH:MM HH:MM]|unschedule|reassert|status" >&2
    exit 1 ;;
esac
