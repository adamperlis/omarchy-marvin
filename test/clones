#!/usr/bin/env python3
"""Invariants for marvin.lock, the one clone that authenticates.

The lock is cloned so the password field can sit on the theme's animated wash
instead of a blurred still. That puts a copy of Omarchy's session lock in this
repo, and two things about it have to stay true.

  1. Service.qml is byte-identical to upstream's. It owns both PAM flows; the
     clone exists to change the view, never the authentication. Anything that
     edits it should have to say so out loud by changing this test. Skipped
     when Omarchy is not installed — there is nothing to compare against.

  2. The wash is one surface, not two that drift. Backdrop.qml, Grain.qml and
     the grain tiles are shared with the screensaver, which cannot import
     across the two install roots, so each ships its own copy. They must match.

  3. The manifest still says clonedFrom omarchy.lock. That line is what makes
     the shell grant the clone the authentication capability (PluginRegistry
     stampHostCapabilities); without it the lock loads and cannot unlock.

Run from the repo root: ./test/clones
"""
import json
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
LOCK = ROOT / "plugins" / "marvin.lock"
UPSTREAM = pathlib.Path("/usr/share/omarchy/shell/plugins/lock")

failed = 0
skipped = 0


def check(ok, label, detail=""):
    global failed
    failed += not ok
    print(f"  {'ok ' if ok else 'BAD'} {label}{('  ' + detail) if detail and not ok else ''}")


def same(a, b):
    return a.exists() and b.exists() and a.read_bytes() == b.read_bytes()


print("== the authentication path is upstream's, untouched")
if (UPSTREAM / "Service.qml").exists():
    check(same(LOCK / "Service.qml", UPSTREAM / "Service.qml"),
          "Service.qml is byte-identical to omarchy.lock's",
          "the clone must not carry its own PAM code")
else:
    skipped += 1
    print(f"  -- skipped: {UPSTREAM} not present (Omarchy not installed here)")

print("== the wash is one surface")
for name in ("Backdrop.qml", "Grain.qml", "grain-light.png", "grain-dark.png"):
    check(same(LOCK / name, ROOT / "screensaver" / name),
          f"{name} matches the screensaver's copy",
          "regenerate by copying screensaver/ -> plugins/marvin.lock/")

print("== the clone still inherits authentication")
manifest = json.loads((LOCK / "manifest.json").read_text(encoding="utf-8"))
omarchy = manifest.get("omarchy", {})
check(omarchy.get("clonedFrom") == "omarchy.lock",
      "manifest declares clonedFrom omarchy.lock",
      f"got {omarchy.get('clonedFrom')!r}")
check("authentication" in omarchy.get("capabilities", []),
      "manifest declares the authentication capability")
check(manifest.get("entryPoints", {}).get("service") == "Service.qml",
      "service entry point is Service.qml")

print(f"\n{failed} failures" + (f", {skipped} skipped" if skipped else ""))
sys.exit(1 if failed else 0)
